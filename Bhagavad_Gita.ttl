###  http://www.semanticweb.org/varshini/ontologies/2025/8/Bhagavad_Gita#hasemotion
:hasemotion rdf:type owl:ObjectProperty ;
            rdfs:comment "wrong entity" ;
            rdfs:seeAlso :hasSubtheme ;
            owl:deprecated "true"^^xsd:boolean .


