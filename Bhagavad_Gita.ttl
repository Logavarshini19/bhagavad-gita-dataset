#################################################################
#    Object Properties
#################################################################

###  http://www.semanticweb.org/varshini/ontologies/2025/8/Bhagavad_Gita#alignsWithEthicalFramework
:alignsWithEthicalFramework rdf:type owl:ObjectProperty ;
                            rdfs:domain [ rdf:type owl:Restriction ;
                                          owl:onProperty owl:topObjectProperty ;
                                          owl:someValuesFrom :Verse
                                        ] ;
                            rdfs:range [ rdf:type owl:Restriction ;
                                         owl:onProperty owl:topObjectProperty ;
                                         owl:someValuesFrom :EthicalFramework
                                       ] .


###  http://www.semanticweb.org/varshini/ontologies/2025/8/Bhagavad_Gita#evokesEmotion
:evokesEmotion rdf:type owl:ObjectProperty ;
               rdfs:domain [ rdf:type owl:Restriction ;
