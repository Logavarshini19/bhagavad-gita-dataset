                             owl:someValuesFrom :Verse
                           ] ;
               rdfs:range [ rdf:type owl:Restriction ;
                            owl:onProperty owl:topObjectProperty ;
                            owl:someValuesFrom :Emotion
                          ] .


###  http://www.semanticweb.org/varshini/ontologies/2025/8/Bhagavad_Gita#hasPhilosophicalReference
:hasPhilosophicalReference rdf:type owl:ObjectProperty ;
